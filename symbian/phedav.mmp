//
// phedav for Symbian^3 (Open C console exe): CardDAV / CalDAV sync. Logs to C:\data\phedav\phedav.log.
// User-grantable capabilities only (self-signed SIS).
TARGET			phedav.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7016B70
SECUREID		0xE7016B70
VENDORID		0
CAPABILITY		NetworkServices ReadUserData WriteUserData

EPOCHEAPSIZE	0x100000 0x2000000
EPOCSTACKSIZE	0x40000

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
USERINCLUDE		. ../include ../.deps/mbedtls/include ../.deps/mbedtls/library
MACRO			PHEDAV_WITH_MBEDTLS
MACRO			MBEDTLS_CONFIG_FILE="\"phedav_mbedtls_cfg.h\""

SOURCEPATH		../src
SOURCE			phedav_xml.c phedav_http.c phedav_dav.c phedav_sync.c phedav_mbedtls.c
SOURCEPATH		.
SOURCE			main.cpp plat.cpp store.cpp contacts.cpp

SOURCEPATH		../.deps/mbedtls/library
SOURCE			aes.c
SOURCE			aesce.c
SOURCE			aesni.c
SOURCE			aria.c
SOURCE			asn1parse.c
SOURCE			asn1write.c
SOURCE			base64.c
SOURCE			bignum.c
SOURCE			bignum_core.c
SOURCE			bignum_mod.c
SOURCE			bignum_mod_raw.c
